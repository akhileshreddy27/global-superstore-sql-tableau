      <aliases enabled='yes' />
      <column datatype='real' default-format='c"$"#,##0;-"$"#,##0' name='[Sales]' role='measure' type='quantitative' />
      <column datatype='real' default-format='c"$"#,##0;-"$"#,##0' name='[Profit]' role='measure' type='quantitative' />
      <column datatype='real' default-format='c"$"#,##0;-"$"#,##0' name='[Shipping Cost]' role='measure' type='quantitative' />
      <column datatype='real' default-format="p0%" name='[Discount]' role='measure' type='quantitative' />
      <column caption="Profit Margin" datatype='real' name='[Calculation_ProfitMargin]' role='measure' type='quantitative' default-format="p0.0%">
        <calculation class='tableau' formula="SUM([Profit]) / SUM([Sales])" />
      </column>
      <column caption="Average Order Value" datatype='real' name='[Calculation_AOV]' role='measure' type='quantitative' default-format='c"$"#,##0;-"$"#,##0'>
        <calculation class='tableau' formula="SUM([Sales]) / COUNTD([Order ID])" />
      </column>
      <column caption="Returned Order" datatype='string' name='[Calculation_ReturnedOrder]' role='dimension' type='nominal'>
        <calculation class='tableau' formula="IF [Returned] = 'Yes' THEN [Order ID] END" />
      </column>
      <column caption="Return Rate" datatype='real' name='[Calculation_ReturnRate]' role='measure' type='quantitative' default-format="p0.0%">
        <calculation class='tableau' formula="COUNTD(IF [Returned] = 'Yes' THEN [Order ID] END) / COUNTD([Order ID])" />
      </column>
      <column caption="Orders" datatype='real' name='[Calculation_Orders]' role='measure' type='quantitative' default-format="n#,##0">
        <calculation class='tableau' formula="COUNTD([Order ID])" />
      </column>
      <column caption="Customers" datatype='real' name='[Calculation_Customers]' role='measure' type='quantitative' default-format="n#,##0">
        <calculation class='tableau' formula="COUNTD([Customer Name])" />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Orders Enriched' datatype='table' name='[__tableau_internal_object_id__].[Orders Enriched]' role='measure' type='quantitative' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Orders Enriched' id='Orders Enriched'>
            <properties context=''>
              <relation connection='hyper.superstore01' name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <actions>
    <action caption="Filter Executive Overview by Sales by Market" name='[Action1]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard="Executive Overview" type='sheet' worksheet="Sales by Market" />
      <command command='tsc:tsl-filter'>
        <param name='special-fields' value='all' />
        <param name='target' value="Executive Overview" />
      </command>
    </action>
    <action caption="Filter Product &amp; Profitability by Profit by Sub-Category" name='[Action2]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard="Product &amp; Profitability" type='sheet' worksheet="Profit by Sub-Category" />
      <command command='tsc:tsl-filter'>
        <param name='special-fields' value='all' />
        <param name='target' value="Product &amp; Profitability" />
      </command>
    </action>
    <action caption="Filter Customers, Regions &amp; Operations by Segment Performance" name='[Action3]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard="Customers, Regions &amp; Operations" type='sheet' worksheet="Segment Performance" />
      <command command='tsc:tsl-filter'>
        <param name='special-fields' value='all' />
        <param name='target' value="Customers, Regions &amp; Operations" />
      </command>
    </action>
  </actions>
  <worksheets>
    <worksheet name="KPI Sales">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Total Sales</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Global Superstore (MySQL v_orders_enriched)" name='federated.superstore01' />
          </datasources>
          <datasource-dependencies datasource='federated.superstore01'>
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.superstore01].[sum:Sales:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='font-size' value='24' />
                <format attr='font-weight' value='bold' />
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
      <simple-id uuid='{DC8895DC-2D3F-5C3B-A310-135F642D8881}' />
    </worksheet>
    <worksheet name="KPI Profit">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Total Profit</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
