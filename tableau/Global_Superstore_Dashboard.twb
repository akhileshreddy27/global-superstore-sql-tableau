            <column caption="Return Rate" datatype='real' name='[Calculation_ReturnRate]' role='measure' type='quantitative'>
              <calculation class='tableau' formula="COUNTD(IF [Returned] = 'Yes' THEN [Order ID] END) / COUNTD([Order ID])" />
            </column>
