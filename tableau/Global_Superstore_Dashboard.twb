            <column-instance column='[Calculation_Orders]' derivation='User' name='[usr:Calculation_Orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Returns Tracked]' derivation='None' name='[none:Returns Tracked:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <computed-sort column='[federated.superstore01].[none:Market:nk]' direction='DESC' using='[federated.superstore01].[usr:Calculation_ReturnRate:qk]' />
